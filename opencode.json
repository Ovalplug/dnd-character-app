{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/devstral-64k",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "devstral-64k": {
          "name": "Devstral Small 2 24B Q4_K_S 64K",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "ask",
    "task": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
